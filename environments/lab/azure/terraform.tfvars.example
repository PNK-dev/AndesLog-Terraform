project                = "andeslog"
environment            = "lab"
owner                  = "equipo"
ttl_date               = "" # Opcional: fecha de revisión AAAA-MM-DD; no elimina recursos automáticamente.
subscription_id        = "00000000-0000-0000-0000-000000000000" # Reemplazar con az account show.
create_blob_role_assignment = false # Solo true si no existe RBAC Blob y la cuenta permite asignar roles.
enable_backup_audit   = false # Usar -EnableBackupAudit en scripts/lab.ps1 para activarlo sin editar este archivo.
backup_function_location = "westus2" # Flex Consumption está disponible aquí; Chile Central no aparece en la lista Flex de la suscripción.
enable_remote_access = false # Usar -EnableRemoteAccess para P2S Windows con Microsoft Entra y acceso a Azure Files.
enable_files_dr_checkpoint = false # Experimental: no activar hasta validar identidad, lease y recuperación con Azure real.
enable_erp_event_archive_replication = false # Experimental: copia asíncrona; requiere pruebas reales y no implementa failover.
enable_erp_failover_ingest = false # Experimental: Function secundaria sin publicación automatizada ni validación cloud.
enable_intercloud_vpn = false # scripts/lab.ps1 habilita el gateway activo-activo y sus cuatro túneles IPsec.
azure_files_quota_gb = 10
create_files_storage_account = false # false importa la cuenta retenida y solicita conversión LRS→ZRS; Destroy la conserva.
existing_files_share_name = "andeslog"
azure_location         = "chilecentral"
