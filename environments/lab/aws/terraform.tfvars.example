project                 = "andeslog"
environment             = "lab"
owner                   = "equipo"
ttl_date                = "" # Opcional: fecha de revisión AAAA-MM-DD; no elimina recursos automáticamente.
aws_region              = "us-east-1"
admin_public_cidr       = "203.0.113.10/32" # Reemplazar por tu IP pública real; es solo ejemplo documental.
azure_peer_public_cidr  = ""               # Poner la IP output de Azure seguida de /32 y volver a aplicar.
azure_wireguard_public_key = "REEMPLAZAR_CON_CLAVE_PUBLICA_AZURE"
azure_vpc_cidr           = "10.20.0.0/16"
ssh_public_key          = "ssh-ed25519 AAAA... reemplazar-por-clave-publica"
existing_key_name       = ""
web_instance_type       = "t3.micro"
db_instance_type        = "t3.micro"
vpn_instance_type       = "t3.micro"
erp_image               = "ghcr.io/organizacion/andeslog-erp:1.0.0" # lab.ps1 sobrescribe este valor y carga la imagen por SSH, incluso si GHCR es privado.
alb_certificate_arn     = "" # Recomendado: ARN ACM validado para un dominio propio; habilita HTTPS y redirección desde HTTP.
enable_temporary_nat    = true              # Solo durante el primer bootstrap; luego cambiar a false.
create_vpn_eip          = false             # Activar solo si el Learner Lab permite Elastic IP.
route_db_to_azure       = false
backup_retention_days   = 7
enable_aws_s3_backups   = false # Activar solo si la cuenta permite s3:GetBucketObjectLockConfiguration.
enable_s3_versioning     = false
