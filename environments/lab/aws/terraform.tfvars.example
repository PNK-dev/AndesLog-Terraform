project                 = "andeslog"
environment             = "lab"
owner                   = "equipo"
ttl_date                = "" # Opcional: fecha de revisión AAAA-MM-DD; no elimina recursos automáticamente.
aws_region              = "us-east-1"
admin_public_cidr       = "203.0.113.10/32" # Reemplazar por tu IP pública real; es solo ejemplo documental.
enable_intercloud_vpn   = false # lab.ps1 crea Azure primero y luego activa la VPN administrada en ambas nubes.
azure_gateway_public_ips = []   # Se completa automáticamente por scripts/lab.ps1; nunca pegar PSK aquí.
azure_vpc_cidr           = "10.20.0.0/16"
ssh_public_key          = "ssh-ed25519 AAAA... reemplazar-por-clave-publica"
existing_key_name       = ""
web_instance_type       = "t3.micro"
web_min_size            = 0 # lab.ps1 escala a 2 tras publicar la imagen y crear el secreto de runtime.
web_desired_capacity    = 0
web_max_size            = 3
bootstrap_instance_enabled = false # lab.ps1 la habilita solo durante el bootstrap y la elimina al completar.
web_instance_profile_name = "" # Si AWS Academy bloquea CreateRole, lab.ps1 detecta LabInstanceProfile/LabRole si existe.
rds_instance_class      = "db.t3.micro"
rds_engine_version      = "16.9"
rds_deletion_protection = true  # El script lab.ps1 la desactiva solo para Destroy -ConfirmDataLoss.
rds_skip_final_snapshot = true  # Solo laboratorio; acepta perder la base al destruir.
erp_image_tag           = "img-bootstrap" # lab.ps1 sustituye la etiqueta por una derivada de la imagen construida localmente.
alb_certificate_arn     = "" # Recomendado: ARN ACM validado para un dominio propio; habilita HTTPS y redirección desde HTTP.
enable_temporary_nat    = true # Activa dos NAT Gateway, uno por AZ, necesarios para reemplazo automático de nodos privados.
backup_retention_days   = 7
rds_backup_retention_days = null # null conserva la retención anterior; RDS admite 1-35 días.
enable_rds_backup_replication = false # Experimental: puede dejar backups facturables tras la baja; no activar todavía.
rds_replica_backup_retention_days = 7
enable_aws_s3_backups   = false # Activar solo si la cuenta permite s3:GetBucketObjectLockConfiguration.
enable_s3_versioning     = false
